#!/usr/bin/env bash
# Fake gh for the PR-shim tests. Appends its argv to $FAKE_GH_LOG and prints canned output.
# $FAKE_GH_MODE: ok (default) · exists (pr create says the PR already exists) · fail (any
# call fails with a message on stderr and exit 1) · raw (pr list serves gh-shaped records, at
# most --limit of them, and applies the real --jq expression with jq; the host has
# $FAKE_GH_LIST_TOTAL records in all, default 3). `pr edit <n> --base <b>` is remembered next to
# the log, and later `pr view` records carry that base. · store (a small host: gh-shaped records
# in the JSON array file $FAKE_GH_STORE, which `pr create`, `pr edit`, `pr list` and `pr view`
# read and write, applying the real --jq expression with jq).
set -u
# One line per call: newlines inside an argument (a multi-line --jq) are logged as spaces.
argv="$*"
printf '%s\n' "${argv//$'\n'/ }" >> "${FAKE_GH_LOG:?FAKE_GH_LOG must be set}"
mode=${FAKE_GH_MODE:-ok}
sub="${1:-} ${2:-}"

if [ "$mode" = fail ]; then
  echo "gh: fake failure for '$sub'" >&2
  exit 1
fi

# store mode: one JSON array of gh-shaped records in $FAKE_GH_STORE.
if [ "$mode" = store ]; then
  db=${FAKE_GH_STORE:?FAKE_GH_STORE must be set}
  [ -f "$db" ] || echo '[]' > "$db"
  shift 2
  state=all jqexpr=. base= head= title= bodyfile= draft=false target=
  while [ $# -gt 0 ]; do
    case "$1" in
      --state) state=$2; shift ;;
      --jq) jqexpr=$2; shift ;;
      --base) base=$2; shift ;;
      --head) head=$2; shift ;;
      --title) title=$2; shift ;;
      --body-file) bodyfile=$2; shift ;;
      --draft) draft=true ;;
      --json | --limit | --search) shift ;;
      *) target=$1 ;;
    esac
    shift
  done
  # A record by number, else the newest record whose head is $target.
  pick='(if ($t | test("^[0-9]+$")) then [.[] | select(.number == ($t | tonumber))]
         else [.[] | select(.headRefName == $t)] end) | last'
  case "$sub" in
    "pr list")
      jq -c --arg s "$state" \
        "[.[] | select(\$s == \"all\" or (.state | ascii_downcase) == \$s)] | $jqexpr" "$db"
      exit $?
      ;;
    "pr view")
      out=$(jq -c --arg t "$target" "$pick" "$db")
      [ "$out" != null ] || { echo "no pull requests found for $target" >&2; exit 1; }
      printf '%s' "$out" | jq -c "$jqexpr"
      exit $?
      ;;
    "pr create")
      if jq -e --arg h "$head" 'any(.[]; .headRefName == $h and .state == "OPEN")' "$db" >/dev/null; then
        echo "a pull request for branch \"$head\" into branch \"$base\" already exists:" >&2
        exit 1
      fi
      n=$(jq '([.[].number] | max // 40) + 1' "$db")
      jq --argjson n "$n" --arg b "$base" --arg h "$head" --arg t "$title" \
        --rawfile body "$bodyfile" --argjson d "$draft" \
        '. + [{number: $n, url: "https://github.com/o/r/pull/\($n)", headRefName: $h,
               baseRefName: $b, state: "OPEN", isDraft: $d, title: $t, body: $body,
               headRefOid: "", reviews: [], comments: []}]' "$db" > "$db.tmp" && mv "$db.tmp" "$db"
      echo "https://github.com/o/r/pull/$n"
      exit 0
      ;;
    "pr edit")
      upd=.
      [ -n "$base" ] && upd="$upd | .baseRefName = \$b"
      [ -n "$bodyfile" ] && upd="$upd | .body = (\$body)"
      jq --arg t "$target" --arg b "$base" --rawfile body "${bodyfile:-/dev/null}" \
        "map(if .number == (\$t | tonumber) then $upd else . end)" "$db" > "$db.tmp" \
        && mv "$db.tmp" "$db"
      exit 0
      ;;
  esac
  echo "fake gh: unhandled '$sub' in store mode" >&2
  exit 1
fi

base=feat/x
[ -f "$FAKE_GH_LOG.base" ] && base=$(cat "$FAKE_GH_LOG.base")
record='{"number":12,"url":"https://github.com/o/r/pull/12","head":"feat/x-slice-1-api","base":"'"$base"'","state":"open","draft":true,"title":"Slice 1: api","body":"Plan: docs/superpowers/plans/p.md","head_sha":"abc1234"}'

case "$sub" in
  "pr create")
    if [ "$mode" = exists ]; then
      echo 'a pull request for branch "feat/x-slice-1-api" into branch "feat/x" already exists:' >&2
      echo 'https://github.com/o/r/pull/12' >&2
      exit 1
    fi
    echo "https://github.com/o/r/pull/12"
    ;;
  "pr view")
    if [[ "$*" == *reviews* ]]; then
      echo '{"number":12,"url":"https://github.com/o/r/pull/12","head":"feat/x-slice-1-api","base":"feat/x","state":"open","draft":true,"title":"Slice 1: api","body":"Plan: docs/superpowers/plans/p.md","head_sha":"abc1234","reviews":[{"author":"ana","state":"changes_requested","body":"rename it"}],"comments":[{"author":"bo","body":"+1","created_at":"2026-09-16T10:00:00Z"}]}'
    else
      echo "$record"
    fi
    ;;
  "pr list")
    if [ "$mode" = raw ]; then
      limit=30 jqexpr=.
      while [ $# -gt 0 ]; do
        case "$1" in
          --limit) limit=$2; shift ;;
          --jq) jqexpr=$2; shift ;;
        esac
        shift
      done
      total=${FAKE_GH_LIST_TOTAL:-3}
      rec() { # number head state
        printf '{"number":%s,"url":"https://github.com/o/r/pull/%s","headRefName":%s,"baseRefName":"feat/x","state":"%s","isDraft":false,"title":"t","body":"","headRefOid":"sha%s"}' \
          "$1" "$1" "$2" "$3" "$1"
      }
      out=$(rec 12 '"feat/x-slice-1-api"' OPEN)
      [ "$total" -ge 2 ] && [ "$limit" -ge 2 ] && out+=,$(rec 13 '"feat/y-slice-1-api"' MERGED)
      [ "$total" -ge 3 ] && [ "$limit" -ge 3 ] && out+=,$(rec 14 '"feat/x\"q-slice-1"' CLOSED)
      i=4
      while [ "$i" -le "$total" ] && [ "$i" -le "$limit" ]; do
        out+=,$(rec $((i + 100)) "\"feat/x-slice-$i\"" OPEN)
        i=$((i + 1))
      done
      printf '[%s]' "$out" | jq -c "$jqexpr"
      exit $?
    fi
    echo '[{"number":12,"url":"https://github.com/o/r/pull/12","head":"feat/x-slice-1-api","base":"feat/x","state":"open","draft":true,"title":"Slice 1: api","body":"","head_sha":"abc1234"},{"number":13,"url":"https://github.com/o/r/pull/13","head":"feat/x-slice-2-web","base":"feat/x-slice-1-api","state":"merged","draft":false,"title":"Slice 2: web","body":"","head_sha":"abc1234"}]'
    ;;
  "pr edit")
    while [ $# -gt 0 ]; do
      [ "$1" = --base ] && printf '%s' "$2" > "$FAKE_GH_LOG.base"
      shift
    done
    ;;
  "pr comment")
    ;;
  *)
    echo "fake gh: unhandled '$sub'" >&2
    exit 1
    ;;
esac
exit 0
