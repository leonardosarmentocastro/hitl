@@ -0,0 +1,9 @@
+import { readFileSync, writeFileSync } from "node:fs";
+import { expect, it } from "vitest";
+import { exportTag } from "./export-tag.js";
+
+it("exports one tag's expenses under a currency header", () => {
+  writeFileSync("expenses.csv", "2026-09-01,12.50,EUR,food\n2026-09-02,40.00,EUR,travel\n");
+  expect(exportTag("food")).toBe(1);
+  expect(readFileSync("out.csv", "utf8")).toBe("date,amount (EUR)\n2026-09-01,12.50\n");
+});
