new file mode 100644
index 0000000..870d80b
--- /dev/null
+++ b/src/export-tag.js
@@ -0,0 +1,18 @@
+import { execSync } from "node:child_process";
+import { readFileSync, writeFileSync } from "node:fs";
+
+// Write the expenses carrying `tag` to out.csv, under a header naming the currency.
+export function exportTag(tag) {
+  execSync(`grep ",${tag}$" expenses.csv > out.csv || true`);
+  const rows = readFileSync("out.csv", "utf8")
+    .split("\n")
+    .filter(Boolean)
+    .map((line) => {
+      const [date, amount, currency] = line.split(",");
+      return { date, amount, currency };
+    });
+  const header = `date,amount (${rows[0].currency})`;
+  const body = rows.map((r) => `${r.date},${r.amount}`);
+  writeFileSync("out.csv", [header, ...body].join("\n") + "\n");
+  return rows.length;
+}
